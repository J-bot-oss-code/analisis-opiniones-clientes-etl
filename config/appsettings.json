{
  "Worker": {
    "IntervaloMinutos": 60
  },
  "Conexiones": {
    "Origen": {
      "Servidor": ".\\SQLEXPRESS",
      "BaseDatos": "OpinionesCliente",
      "Driver": "ODBC Driver 17 for SQL Server",
      "AutenticacionWindows": false,
      "VariableUsuario": "SQL_ORIGEN_USUARIO",
      "VariableClave": "SQL_ORIGEN_CLAVE",
      "OpcionesOdbc": { "TrustServerCertificate": "yes" }
    },
    "Destino": {
      "Servidor": ".\\SQLEXPRESS",
      "BaseDatos": "OpinionesCliente_DW",
      "Driver": "ODBC Driver 17 for SQL Server",
      "AutenticacionWindows": false,
      "VariableUsuario": "SQL_DESTINO_USUARIO",
      "VariableClave": "SQL_DESTINO_CLAVE",
      "OpcionesOdbc": { "TrustServerCertificate": "yes" }
    }
  },
  "Extraccion": {
    "TamanoLote": 5000
  },
  "Fuentes": [
    {
      "Nombre": "BD_Categoria",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdCategoria, Nombre FROM dbo.Categoria",
      "TablaDestino": "stg.Categoria"
    },
    {
      "Nombre": "BD_Clasificacion",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdClasificacion, Nombre FROM dbo.Clasificacion",
      "TablaDestino": "stg.Clasificacion"
    },
    {
      "Nombre": "BD_Cliente",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdCliente, Nombre, Email FROM dbo.Cliente",
      "TablaDestino": "stg.Cliente"
    },
    {
      "Nombre": "BD_FuenteDatos",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdFuente, TipoFuente, FechaCarga FROM dbo.FuenteDatos",
      "TablaDestino": "stg.FuenteDatos"
    },
    {
      "Nombre": "BD_Producto",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdProducto, Nombre, IdCategoria FROM dbo.Producto",
      "TablaDestino": "stg.Producto"
    },
    {
      "Nombre": "BD_Opinion",
      "Tipo": "BD",
      "Activa": true,
      "Consulta": "SELECT IdOpinion, IdCliente, IdProducto, IdClasificacion, IdFuente, Fecha, Comentario, PuntajeSatisfaccion FROM dbo.Opinion",
      "TablaDestino": "stg.Opinion"
    },
    {
      "Nombre": "CSV_Encuestas",
      "Tipo": "CSV",
      "Activa": true,
      "Ruta": "data/surveys_part1.csv",
      "Codificacion": "utf-8-sig",
      "Columnas": {
        "IdOpinion": "IdOpinion",
        "IdCliente": "IdCliente",
        "IdProducto": "IdProducto",
        "Fecha": "Fecha",
        "Comentario": "Comentario",
        "Clasificación": "Clasificacion",
        "PuntajeSatisfacción": "PuntajeSatisfaccion",
        "Fuente": "Fuente"
      },
      "TablaDestino": "stg.EncuestaCSV"
    },
    {
      "Nombre": "CSV_Resenas",
      "Tipo": "CSV",
      "Activa": true,
      "Ruta": "data/web_reviews.csv",
      "Codificacion": "utf-8-sig",
      "Columnas": {
        "IdReview": "IdReview",
        "IdCliente": "IdCliente",
        "IdProducto": "IdProducto",
        "Fecha": "Fecha",
        "Comentario": "Comentario",
        "Rating": "Rating"
      },
      "TablaDestino": "stg.ResenaWeb"
    },
    {
      "Nombre": "API_Comentarios",
      "Tipo": "API",
      "Activa": true,
      "UrlBase": "http://127.0.0.1:8000",
      "Endpoint": "/api/comentarios",
      "VariableApiKey": "API_COMENTARIOS_KEY",
      "TamanoPagina": 50,
      "MaxConcurrencia": 4,
      "TimeoutSegundos": 10,
      "Reintentos": 3,
      "Columnas": ["IdComment", "IdCliente", "IdProducto", "Fuente", "Fecha", "Comentario"],
      "TablaDestino": "stg.ComentarioAPI"
    }
  ],
  "Dimensiones": {
    "MiembroDesconocido": false,
    "Fecha": { "Inicio": "2024-01-01", "Fin": "2025-12-31" }
  },
  "Hechos": {
    "TamanoLote": 500,
    "IdFuenteEncuestas": 2,
    "FuentesExcluidasDeOpiniones": [1]
  },
  "Logging": {
    "Nivel": "INFO",
    "Archivo": "logs/extraccion.log",
    "MaxBytes": 1048576,
    "Respaldos": 5
  }
}
