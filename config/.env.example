# Copia este archivo como config/.env y completa los valores.
# config/.env está excluido de Git: nunca subas contraseñas ni llaves.

# Llave que protege la API local de comentarios (la usan la API y el worker).
# Usa un valor largo y aleatorio, por ejemplo el resultado de:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_COMENTARIOS_KEY=cambia-esta-llave

# Solo si en appsettings.json pones "AutenticacionWindows": false
# (login de SQL Server con autenticación mixta, por ejemplo etl_extractor).
SQL_ORIGEN_USUARIO=
SQL_ORIGEN_CLAVE=
SQL_DESTINO_USUARIO=
SQL_DESTINO_CLAVE=
